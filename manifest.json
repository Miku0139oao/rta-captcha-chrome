{
  "manifest_version": 3,
  "name": "RTA Captcha OCR",
  "version": "1.0.0",
  "description": "在本機辨識 RTA SSO 的五位十六進位驗證碼，僅自動填入驗證碼欄位。",
  "homepage_url": "https://github.com/Miku0139oao/rta-captcha-chrome",
  "minimum_chrome_version": "109",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "RTA Captcha OCR",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "offscreen"
  ],
  "host_permissions": [
    "https://sso.rta-os.com/*",
    "https://mansso.rta-os.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sso.rta-os.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "match_about_blank": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
